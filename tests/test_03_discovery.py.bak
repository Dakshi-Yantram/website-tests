"""Phase 3: discover & inventory every page reachable through the UI, per role."""
import pytest

from config import EXPECTED_MENU
from conftest import ROLE_NAMES
from utils.recorder import REC

T = "03_discovery"


@pytest.mark.parametrize("role", ROLE_NAMES)
def test_discover_pages(role, need_session, inventories):
    s = need_session(role, T)
    pages = inventories(role)

    with REC.step(T, "Crawl finds at least one page", role, "Inventory not empty (saved in artifacts/inventory)", s.page, s.mon, "High") as st:
        st.actual = f"{len(pages)} pages discovered: " + ", ".join(p.get("url", "?") for p in pages[:15])
        assert pages, "Nothing discovered"

    with REC.step(T, "Discovered menu / link list recorded", role, "Sidebar items listed", s.page, s.mon, "Low") as st:
        items = sorted({i["text"] for p in pages for i in p.get("sidebar", []) if i["text"]})
        st.actual = "Menu items: " + "; ".join(items)[:900]
        assert items, "No sidebar/nav items found (UI may use unusual markup)"

    for expected in EXPECTED_MENU.get(role, []):
        with REC.step(T, f"Expected menu item present: {expected}", role,
                      f"'{expected}' visible in UI for this role (from your screenshot)", s.page, s.mon, "Medium") as st:
            haystack = " | ".join(i["text"] for p in pages for i in p.get("sidebar", []) + p.get("links", []))
            haystack += " | " + " | ".join(h for p in pages for h in p.get("headings", []))
            found = expected.lower() in haystack.lower()
            st.actual = "Found" if found else "Not found in any discovered page for this role (verify against role permissions)"
            assert found, st.actual

    for p in pages:
        with REC.step(T, f"Inventory entry: {p.get('url','?')}", role, "Page reachable with HTTP < 400, content, not login",
                      None, None, "Medium") as st:
            st.actual = (f"status={p.get('status')} title='{p.get('title','')}' forms={p.get('forms')} tables={p.get('tables')} "
                         f"search={p.get('search')} tabs={len(p.get('tabs', []))} buttons={len(p.get('buttons', []))}")
            assert not p.get("error"), p.get("error")
            assert (p.get("status") or 0) < 400, f"HTTP {p.get('status')}"
            assert not p.get("login_redirect"), "Redirected to login"
            assert p.get("textLen", 0) > 0, "Empty page"
