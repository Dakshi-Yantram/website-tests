# Copy this file to ".env" and fill in the passwords. NEVER commit .env to Git.

# ---- Sites ----
NURSECONNECT_URL=https://nurseconnect.co.in
NURSECONNECT_LOGIN_PATH=/auth/login
HOSPITAL_URL=http://hospitaldashboard-env.eba-n7anfees.ap-south-1.elasticbeanstalk.com
HOSPITAL_LOGIN_PATH=/login

# ---- Test accounts ----
NURSE_EMAIL=nurse@example.invalid
NURSE_PASSWORD=
CONSUMER_EMAIL=consumer@example.invalid
CONSUMER_PASSWORD=
RECEPTION_EMAIL=reception@example.invalid
RECEPTION_PASSWORD=
DOCTOR_EMAIL=doctor@example.invalid
DOCTOR_PASSWORD=

# ---- Behaviour ----
HEADLESS=true
SLOW_MO_MS=0
MAX_PAGES_PER_ROLE=40
NAV_TIMEOUT_MS=30000
# Set true ONLY on a staging/test environment. Lets workflows create records
# (all tagged AUTOTEST_<runid>). Payments are NEVER automated.
ALLOW_WRITE_TESTS=false

# --- NurseConnect operations / reviewer / admin roles and the lockout test account (STAGING values only; never production) ---
OPS_EMAIL=ops@example.invalid
OPS_PASSWORD=
REVIEWER_EMAIL=reviewer@example.invalid
REVIEWER_PASSWORD=
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=
# A throw-away staging account that the brute-force test will deliberately lock:
LOCKOUT_EMAIL=lockout@example.invalid
LOCKOUT_PASSWORD=

# Optional synthetic attack strings for read-only staging login-input security tests.
# Do not use real credentials. These are test inputs, not login passwords.
QA_INJECTION_EMAIL=
QA_INJECTION_PASSWORD=

# ---- Login agent (python -m login_agent) - see docs/LOGIN_AGENT.md.  STAGING accounts only, never production ----
LOGIN_AGENT_ENV=production
NC_TEST_CONSUMER_PASSWORD=
NC_TEST_WORKER_PASSWORD=
# Optional overrides (leave empty to use fake-id/test-identities.yaml):
NC_TEST_CONSUMER_EMAIL=
NC_TEST_WORKER_EMAIL=
NC_TEST_INVALID_EMAIL=
# Optional: staging API origin that may receive the login POST (must be in allowed_origins of the staging environment)
LOGIN_TEST_API_ORIGIN=
LOGIN_SCREENSHOT_MODE=masked
